@{
    ViewData["Title"] = "Ürün Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Scripts {
    <script>
        const adminToken = sessionStorage.getItem('adminToken');
        

        let allProducts = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Products));
        let filtered = [...allProducts];
        let currentPage = 1;
        const pageSize = 10;

        function renderTable() {
            const start = (currentPage - 1) * pageSize;
            const paged = filtered.slice(start, start + pageSize);
            const tbody = document.getElementById('productTbody');

            if (paged.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;padding:2rem;color:var(--text-muted)">
                    <i class="fas fa-box-open" style="font-size:1.5rem;display:block;margin-bottom:0.5rem"></i>Ürün bulunamadı</td></tr>`;
                return;
            }

            tbody.innerHTML = paged.map(p => `
                <tr>
                    <td>
                        <div style="display:flex;align-items:center;gap:0.75rem">
                            <div class="product-thumb">
                                ${p.ImageUrl ? `<img src="${p.ImageUrl}" onerror="this.style.display='none'" />` : `<i class="fas fa-box"></i>`}
                            </div>
                            <div>
                                <div style="font-weight:600;color:var(--text);font-size:0.85rem">${p.Name}</div>
                                <div style="font-size:0.72rem;color:var(--text-muted)">${p.Brand || '-'}</div>
                            </div>
                        </div>
                    </td>
                    <td><span class="badge badge-gray">${p.CategoryName}</span></td>
                    <td style="font-weight:700;color:var(--accent)">${p.Price.toLocaleString('tr-TR')}₺</td>
                    <td>
                        <span class="${p.Stock === 0 ? 'badge badge-red' : p.Stock <= 5 ? 'badge badge-yellow' : 'badge badge-green'}">
                            ${p.Stock === 0 ? 'Tükendi' : p.Stock + ' adet'}
                        </span>
                    </td>
                    <td>
                        <span class="${p.IsActive ? 'badge badge-green' : 'badge badge-red'}">
                            ${p.IsActive ? 'Aktif' : 'Pasif'}
                        </span>
                    </td>
                    <td style="font-size:0.78rem;color:var(--text-muted)">${new Date(p.CreatedAt).toLocaleDateString('tr-TR')}</td>
                    <td>
                        <div style="display:flex;gap:0.4rem">
                            <button class="btn-edit" onclick="editProduct('${p.Id}')"><i class="fas fa-pen"></i></button>
                            <button class="btn-danger" onclick="deleteProduct('${p.Id}', '${p.Name.replace(/'/g, "\\'")}')"><i class="fas fa-trash"></i></button>
                        </div>
                    </td>
                </tr>
            `).join('');

            renderPagination();
        }

        function renderPagination() {
            const totalPages = Math.ceil(filtered.length / pageSize);
            document.getElementById('paginationInfo').textContent =
                `${filtered.length} üründen ${Math.min((currentPage-1)*pageSize+1, filtered.length)}-${Math.min(currentPage*pageSize, filtered.length)} gösteriliyor`;

            const el = document.getElementById('pagination');
            if (totalPages <= 1) { el.innerHTML = ''; return; }

            let html = `<button class="page-btn" onclick="goPage(${currentPage-1})" ${currentPage===1?'disabled':''}><i class="fas fa-chevron-left"></i></button>`;
            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= currentPage-1 && i <= currentPage+1)) {
                    html += `<button class="page-btn ${i===currentPage?'active':''}" onclick="goPage(${i})">${i}</button>`;
                } else if (i === currentPage-2 || i === currentPage+2) {
                    html += `<span style="padding:0 0.25rem;color:var(--text-muted)">...</span>`;
                }
            }
            html += `<button class="page-btn" onclick="goPage(${currentPage+1})" ${currentPage===totalPages?'disabled':''}><i class="fas fa-chevron-right"></i></button>`;
            el.innerHTML = html;
        }

        function goPage(p) {
            const totalPages = Math.ceil(filtered.length / pageSize);
            if (p < 1 || p > totalPages) return;
            currentPage = p;
            renderTable();
        }

        function applyFilters() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const category = document.getElementById('categoryFilter').value;
            const stock = document.getElementById('stockFilter').value;

            filtered = allProducts.filter(p => {
                const matchSearch = !search || p.Name.toLowerCase().includes(search) || p.Brand?.toLowerCase().includes(search);
                const matchCat = !category || p.CategoryName === category;
                const matchStock = !stock ||
                    (stock === 'instock' && p.Stock > 0) ||
                    (stock === 'outstock' && p.Stock === 0) ||
                    (stock === 'low' && p.Stock > 0 && p.Stock <= 5);
                return matchSearch && matchCat && matchStock;
            });

            currentPage = 1;
            renderTable();
        }

        function editProduct(id) {
            window.location.href = `/Product/Detail/${id}`;
        }

        async function deleteProduct(id, name) {
            if (!confirm(`"${name}" ürününü silmek istediğinize emin misiniz?`)) return;
            try {
                const res = await fetch(`https://localhost:7136/api/product/${id}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': 'Bearer ' + adminToken }
                });
                if (res.ok) {
                    allProducts = allProducts.filter(p => p.Id !== id);
                    filtered = filtered.filter(p => p.Id !== id);
                    renderTable();
                    showToast('Ürün silindi.');
                    updateStats();
                } else {
                    showToast('Silme işlemi başarısız.', 'error');
                }
            } catch { showToast('Bağlantı hatası.', 'error'); }
        }

        function updateStats() {
            document.getElementById('statTotal').textContent = allProducts.length;
            document.getElementById('statActive').textContent = allProducts.filter(p => p.IsActive).length;
            document.getElementById('statOut').textContent = allProducts.filter(p => p.Stock === 0).length;
        }

        document.addEventListener('DOMContentLoaded', () => renderTable());
    </script>
}

<style>
    .page-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--text);
        letter-spacing: -0.01em;
    }

    .page-sub {
        font-size: 0.82rem;
        color: var(--text-muted);
        margin-top: 0.3rem;
    }

    .stat-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .stat-mini {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.1rem 1.5rem;
        box-shadow: var(--shadow);
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .stat-mini-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .stat-mini-value {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--text);
        line-height: 1;
    }

    .stat-mini-label {
        font-size: 0.72rem;
        color: var(--text-muted);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 0.15rem;
    }

    .table-wrap {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .table-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.1rem 1.5rem;
        border-bottom: 1px solid var(--border);
        background: var(--surface2);
        gap: 1rem;
        flex-wrap: wrap;
    }

    .toolbar-left {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        flex-wrap: wrap;
    }

    .filter-select {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text);
        font-family: var(--font);
        font-size: 0.82rem;
        padding: 0.5rem 0.75rem;
        outline: none;
        cursor: pointer;
        transition: border-color 0.2s;
    }

        .filter-select:focus {
            border-color: var(--accent);
        }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead th {
        padding: 0.75rem 1.5rem;
        text-align: left;
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        background: var(--surface2);
        border-bottom: 1px solid var(--border);
    }

    tbody td {
        padding: 0.9rem 1.5rem;
        border-bottom: 1px solid var(--border);
        vertical-align: middle;
        font-size: 0.85rem;
        color: var(--text-dim);
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    tbody tr:hover td {
        background: #fafbff;
    }

    .product-thumb {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        background: var(--surface2);
        border: 1px solid var(--border);
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        color: var(--text-muted);
        flex-shrink: 0;
    }

        .product-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .btn-edit {
        background: var(--accent-bg);
        color: var(--accent);
        border: 1px solid rgba(66,122,181,0.2);
        border-radius: 6px;
        padding: 0.4rem 0.6rem;
        cursor: pointer;
        font-size: 0.78rem;
        transition: background 0.15s;
    }

        .btn-edit:hover {
            background: rgba(66,122,181,0.15);
        }

    .btn-danger {
        background: #fff5f5;
        color: var(--danger);
        border: 1px solid #fed7d7;
        border-radius: 6px;
        padding: 0.4rem 0.6rem;
        cursor: pointer;
        font-size: 0.78rem;
        transition: background 0.15s;
    }

        .btn-danger:hover {
            background: #ffe4e4;
        }

    .table-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.5rem;
        border-top: 1px solid var(--border);
        background: var(--surface2);
        font-size: 0.78rem;
        color: var(--text-muted);
    }

    .pagination {
        display: flex;
        gap: 0.3rem;
        align-items: center;
    }

    .page-btn {
        width: 30px;
        height: 30px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        color: var(--text-dim);
        font-size: 0.78rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s;
    }

        .page-btn:hover:not(:disabled) {
            background: var(--accent-bg);
            color: var(--accent);
            border-color: rgba(66,122,181,0.3);
        }

        .page-btn.active {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
        }

        .page-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }
</style>

<div class="page-header">
    <div>
        <div class="page-title">Ürün Yönetimi</div>
        <div class="page-sub">Tüm ürünleri görüntüleyin ve yönetin</div>
    </div>
</div>

<div class="stat-row">
    <div class="stat-mini">
        <div class="stat-mini-icon icon-blue"><i class="fas fa-box"></i></div>
        <div>
            <div class="stat-mini-value" id="statTotal">@ViewBag.TotalProducts</div>
            <div class="stat-mini-label">Toplam Ürün</div>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-mini-icon icon-green"><i class="fas fa-circle-check"></i></div>
        <div>
            <div class="stat-mini-value" id="statActive">@ViewBag.ActiveProducts</div>
            <div class="stat-mini-label">Aktif Ürün</div>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-mini-icon icon-red"><i class="fas fa-ban"></i></div>
        <div>
            <div class="stat-mini-value" id="statOut">@ViewBag.OutOfStock</div>
            <div class="stat-mini-label">Tükenen Ürün</div>
        </div>
    </div>
</div>

<div class="table-wrap">
    <div class="table-toolbar">
        <div class="toolbar-left">
            <input type="text" id="searchInput" class="search-input" placeholder="Ürün veya marka ara..." oninput="applyFilters()" style="width:220px" />
            <select id="categoryFilter" class="filter-select" onchange="applyFilters()">
                <option value="">Tüm Kategoriler</option>
                @if (ViewBag.Categories != null)
                {
                    foreach (var cat in ViewBag.Categories)
                    {
                        <option value="@cat.Name">@cat.Name</option>
                    }
                }
            </select>
            <select id="stockFilter" class="filter-select" onchange="applyFilters()">
                <option value="">Tüm Stok</option>
                <option value="instock">Stokta Var</option>
                <option value="low">Az Kaldı (≤5)</option>
                <option value="outstock">Tükendi</option>
            </select>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Ürün</th>
                <th>Kategori</th>
                <th>Fiyat</th>
                <th>Stok</th>
                <th>Durum</th>
                <th>Tarih</th>
                <th>İşlem</th>
            </tr>
        </thead>
        <tbody id="productTbody">
            <tr>
                <td colspan="7" style="text-align:center;padding:2rem;color:var(--text-muted)">
                    <i class="fas fa-spinner fa-spin"></i> Yükleniyor...
                </td>
            </tr>
        </tbody>
    </table>

    <div class="table-footer">
        <span id="paginationInfo"></span>
        <div class="pagination" id="pagination"></div>
    </div>
</div>
