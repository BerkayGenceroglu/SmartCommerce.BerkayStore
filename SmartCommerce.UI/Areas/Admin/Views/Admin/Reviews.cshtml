@{
    ViewData["Title"] = "Yorum Yönetimi";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Scripts {
    <script>
        // Orijinal sayfa yapındaki gibi veriyi güvenli bir şekilde JSON'a çevirip JS tarafına alıyoruz
        let allReviews = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Reviews, 
            new Newtonsoft.Json.JsonSerializerSettings { 
                ContractResolver = new Newtonsoft.Json.Serialization.CamelCasePropertyNamesContractResolver() 
            }));
            
        let filtered = [...allReviews];
        let currentPage = 1;
        const pageSize = 10;

        function renderTable() {
            const start = (currentPage - 1) * pageSize;
            const paged = filtered.slice(start, start + pageSize);
            const tbody = document.getElementById('reviewTbody');

            if (paged.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;padding:2rem;color:var(--text-muted)">
                    <i class="far fa-comments" style="font-size:1.5rem;display:block;margin-bottom:0.5rem"></i>Henüz yorum bulunmuyor.</td></tr>`;
                return;
            }

            tbody.innerHTML = paged.map(r => {
                // Tarih formatlama işlemi
                const dateObj = new Date(r.createdAt);
                const formattedDate = isNaN(dateObj.getTime()) ? '-' : dateObj.toLocaleDateString('tr-TR', {
                    day: '2-digit', month: 'short', year: 'numeric'
                });
                const formattedTime = isNaN(dateObj.getTime()) ? '' : dateObj.toLocaleTimeString('tr-TR', {
                    hour: '2-digit', minute: '2-digit'
                });

                // Hatanın çözüldüğü ve tablonun basıldığı alan
                return `
                <tr>
                    <td class="td-name">${r.userFullName}</td>
                    <td style="font-family: monospace; font-size: 0.8rem;">
                        #${r.productId ? r.productId.substring(0, 8).toUpperCase() : '-'}
                    </td>
                    <td style="font-weight: 700; color: var(--warning);">
                        <i class="fas fa-star" style="font-size: 0.75rem;"></i> ${r.rating}
                    </td>
                    <td>
                        <div class="comment-box">${r.comment}</div>
                    </td>
                    <td style="text-align: right; color: var(--text-muted); font-size: 0.78rem;">
                        <div>${formattedDate}</div>
                        <div style="font-size: 0.7rem; margin-top: 0.15rem;">${formattedTime}</div>
                    </td>
                </tr>
                `;
            }).join('');

            renderPagination();
        }

        function renderPagination() {
            const totalPages = Math.ceil(filtered.length / pageSize);
            const infoEl = document.getElementById('paginationInfo');

            if (filtered.length === 0) {
                infoEl.textContent = "Gösterilecek kayıt yok";
                document.getElementById('pagination').innerHTML = '';
                return;
            }

            infoEl.textContent = `${filtered.length} yorumdan ${Math.min((currentPage-1)*pageSize+1, filtered.length)}-${Math.min(currentPage*pageSize, filtered.length)} gösteriliyor`;

            const el = document.getElementById('pagination');
            if (totalPages <= 1) { el.innerHTML = ''; return; }

            let html = `<button class="page-btn" onclick="goPage(${currentPage-1})" ${currentPage===1?'disabled':''}><i class="fas fa-chevron-left"></i></button>`;
            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= currentPage-1 && i <= currentPage+1)) {
                    html += `<button class="page-btn ${i===currentPage?'active':''}" onclick="goPage(${i})">${i}</button>`;
                } else if (i === currentPage-2 || i === currentPage+2) {
                    html += `<span style="padding:0 0.25rem;color:var(--text-muted)">...</span>`;
                }
            }
            html += `<button class="page-btn" onclick="goPage(${currentPage+1})" ${currentPage===totalPages?'disabled':''}><i class="fas fa-chevron-right"></i></button>`;
            el.innerHTML = html;
        }

        function goPage(p) {
            const totalPages = Math.ceil(filtered.length / pageSize);
            if (p < 1 || p > totalPages) return;
            currentPage = p;
            renderTable();
        }

        function applyFilters() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            filtered = allReviews.filter(r => 
                !search || 
                r.userFullName.toLowerCase().includes(search) || 
                r.comment.toLowerCase().includes(search)
            );
            currentPage = 1;
            renderTable();
        }

        document.addEventListener('DOMContentLoaded', () => renderTable());
    </script>
}

<style>
    .page-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 2rem; }
    .page-title { font-size: 1.4rem; font-weight: 800; color: var(--text); letter-spacing: -0.01em; }
    .page-sub { font-size: 0.82rem; color: var(--text-muted); margin-top: 0.3rem; }
    
    .stat-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-bottom: 1.5rem; }
    .stat-mini { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.1rem 1.5rem; box-shadow: var(--shadow); display: flex; align-items: center; gap: 1rem; }
    .stat-mini-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0; }
    .stat-mini-value { font-size: 1.5rem; font-weight: 800; color: var(--text); line-height: 1; }
    .stat-mini-label { font-size: 0.72rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.15rem; }
    
    /* Layoutundaki Orijinal İkili Panel Yapısı */
    .bottom-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 1.5rem; }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; box-shadow: var(--shadow); overflow: hidden; }
    .card-header { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.5rem; border-bottom: 1px solid var(--border); background: var(--surface2); }
    .card-title { font-size: 0.88rem; font-weight: 700; color: var(--text); }
    
    .analytics-row { display: flex; align-items: center; gap: 0.75rem; padding: 0.8rem 1.25rem; border-bottom: 1px solid var(--border); transition: background 0.15s; }
    .analytics-row:last-child { border-bottom: none; }
    .analytics-row:hover { background: #fafbff; }
    .analytics-info { flex: 1; min-width: 0; }
    .analytics-name { font-size: 0.8rem; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .analytics-meta { font-size: 0.68rem; color: var(--text-muted); }
    .analytics-right { text-align: right; flex-shrink: 0; }
    .analytics-value { font-size: 0.85rem; font-weight: 700; color: var(--text); }

    /* Tablo Alanı */
    .table-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; box-shadow: var(--shadow); overflow: hidden; }
    .table-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 1.1rem 1.5rem; border-bottom: 1px solid var(--border); background: var(--surface2); gap: 1rem; }
    .toolbar-left { display: flex; gap: 0.5rem; align-items: center; }
    
    table { width: 100%; border-collapse: collapse; }
    thead th { padding: 0.75rem 1.5rem; text-align: left; font-size: 0.68rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); background: var(--surface2); border-bottom: 1px solid var(--border); }
    tbody td { padding: 0.9rem 1.5rem; border-bottom: 1px solid var(--border); vertical-align: middle; font-size: 0.85rem; color: var(--text-dim); }
    tbody tr:last-child td { border-bottom: none; }
    tbody tr:hover td { background: #fafbff; }
    
    .td-name { font-weight: 600; color: var(--text); }
    .comment-box { max-width: 450px; word-break: break-word; color: var(--text-dim); line-height: 1.4; }
    
    .table-footer { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.5rem; border-top: 1px solid var(--border); background: var(--surface2); font-size: 0.78rem; color: var(--text-muted); }
    .pagination { display: flex; gap: 0.3rem; align-items: center; }
    .page-btn { width: 30px; height: 30px; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; color: var(--text-dim); font-size: 0.78rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.15s; }
    .page-btn:hover:not(:disabled) { background: var(--accent-bg); color: var(--accent); border-color: rgba(66,122,181,0.3); }
    .page-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }
    .page-btn:disabled { opacity: 0.4; cursor: not-allowed; }
</style>

<div class="page-header">
    <div>
        <div class="page-title">Yorum Yönetimi</div>
        <div class="page-sub">Müşteri yorumlarını görüntüleyin, filtreleyin ve analiz edin</div>
    </div>
</div>

<div class="stat-row">
    <div class="stat-mini">
        <div class="stat-mini-icon icon-blue" style="background: rgba(66,122,181,0.1); color: var(--accent);"><i class="far fa-comments"></i></div>
        <div>
            <div class="stat-mini-value">@ViewBag.TotalReviews</div>
            <div class="stat-mini-label">Toplam Yorum</div>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-mini-icon icon-green" style="background: rgba(214,158,46,0.1); color: var(--warning);"><i class="fas fa-star"></i></div>
        <div>
            <div class="stat-mini-value" style="color: var(--warning);">@(((double)ViewBag.AverageRating).ToString("F1"))</div>
            <div class="stat-mini-label">Ortalama Skor</div>
        </div>
    </div>
</div>

<div class="bottom-grid">
    <div class="card">
        <div class="card-header">
            <div class="card-title">En Çok Etkileşim Alan Ürünler</div>
        </div>
        @if (ViewBag.WithTheMostComments != null)
        {
            foreach (var item in ViewBag.WithTheMostComments)
            {
                <div class="analytics-row">
                    <div class="analytics-info">
                        <div class="analytics-name">@item.ProductName</div>
                        <div class="analytics-meta">ID: #@item.ProductId.ToString().Substring(0, 8).ToUpper()</div>
                    </div>
                    <div class="analytics-right">
                        <div class="analytics-value" style="color: var(--accent);">@item.CommentCount Adet</div>
                        <div class="analytics-meta">toplam yorum</div>
                    </div>
                </div>
            }
        }
    </div>

    <div class="card">
        <div class="card-header">
            <div class="card-title">En Yüksek Puanlı Ürünler</div>
        </div>
        @if (ViewBag.TopRatedProducts != null)
        {
            foreach (var item in ViewBag.TopRatedProducts)
            {
                <div class="analytics-row">
                    <div class="analytics-info">
                        <div class="analytics-name">@item.ProductName</div>
                        <div class="analytics-meta">@item.CommentCount değerlendirme</div>
                    </div>
                    <div class="analytics-right">
                        <div class="analytics-value" style="color: var(--warning);">
                            <i class="fas fa-star" style="font-size: 0.75rem;"></i> @item.AverageRating.ToString("F1")
                        </div>
                        <div class="analytics-meta">/ 5.0 skor</div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<div class="table-wrap">
    <div class="table-toolbar">
        <div class="toolbar-left">
            <input type="text" id="searchInput" class="search-input" placeholder="Müşteri veya yorum ara..." oninput="applyFilters()" style="width:260px; background: var(--surface2); border: 1px solid var(--border); border-radius: 8px; color: var(--text); font-size: 0.82rem; padding: 0.5rem 0.85rem; outline: none;" />
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Müşteri</th>
                <th>Ürün Referans</th>
                <th>Puan</th>
                <th>Yorum</th>
                <th style="text-align: right;">Tarih</th>
            </tr>
        </thead>
        <tbody id="reviewTbody">
            <tr><td colspan="5" style="text-align:center;padding:2rem;color:var(--text-muted)"><i class="fas fa-spinner fa-spin"></i> Yükleniyor...</td></tr>
        </tbody>
    </table>

    <div class="table-footer">
        <span id="paginationInfo"></span>
        <div class="pagination" id="pagination"></div>
    </div>
</div>