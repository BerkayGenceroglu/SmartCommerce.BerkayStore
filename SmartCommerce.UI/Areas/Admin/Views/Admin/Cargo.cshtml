
@{
    ViewData["Title"] = "Cargo";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}


@section Scripts {
    <script>

        let allCargos = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Cargos));
        let filtered = [...allCargos];
        let currentPage = 1;
        const pageSize = 10;

        function getStatusBadge(status) {
            switch(status) {
                case 'Preparing': return '<span class="badge badge-yellow">Hazırlanıyor</span>';
                case 'Shipped':   return '<span class="badge badge-blue">Kargoda</span>';
                case 'Delivered': return '<span class="badge badge-green">Teslim Edildi</span>';
                default:          return '<span class="badge badge-gray">' + status + '</span>';
            }
        }

        function renderTable() {
            const start = (currentPage - 1) * pageSize;
            const paged = filtered.slice(start, start + pageSize);
            const tbody = document.getElementById('cargoTbody');

            if (paged.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;padding:2rem;color:var(--text-muted)">
                    <i class="fas fa-truck" style="font-size:1.5rem;display:block;margin-bottom:0.5rem"></i>Kargo bulunamadı</td></tr>`;
                return;
            }

            tbody.innerHTML = paged.map(c => `
            <tr>
                <td>
                    <div style="font-weight:700;color:var(--accent);font-family:monospace;font-size:0.88rem">${c.TrackingNumber}</div>
                </td>
                <td>
                    <div style="font-weight:600;color:var(--text);font-family:monospace;font-size:0.82rem">#${c.OrderId.substring(0,8).toUpperCase()}</div>
                </td>
                <td>${getStatusBadge(c.Status)}</td>
                <td style="font-size:0.78rem;color:var(--text-muted)">${new Date(c.CreatedAt).toLocaleDateString('tr-TR')}</td>
                <td>
                    <div style="font-size:0.72rem;color:var(--text-muted);font-family:monospace">${c.Id.substring(0,8).toUpperCase()}</div>
                </td>
            </tr>
        `).join('');

            renderPagination();
        }

        function renderPagination() {
            const totalPages = Math.ceil(filtered.length / pageSize);
            document.getElementById('paginationInfo').textContent =
                `${filtered.length} kayıttan ${Math.min((currentPage-1)*pageSize+1, filtered.length)}-${Math.min(currentPage*pageSize, filtered.length)} gösteriliyor`;

            const el = document.getElementById('pagination');
            if (totalPages <= 1) { el.innerHTML = ''; return; }

            let html = `<button class="page-btn" onclick="goPage(${currentPage-1})" ${currentPage===1?'disabled':''}><i class="fas fa-chevron-left"></i></button>`;
            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= currentPage-1 && i <= currentPage+1)) {
                    html += `<button class="page-btn ${i===currentPage?'active':''}" onclick="goPage(${i})">${i}</button>`;
                } else if (i === currentPage-2 || i === currentPage+2) {
                    html += `<span style="padding:0 0.25rem;color:var(--text-muted)">...</span>`;
                }
            }
            html += `<button class="page-btn" onclick="goPage(${currentPage+1})" ${currentPage===totalPages?'disabled':''}><i class="fas fa-chevron-right"></i></button>`;
            el.innerHTML = html;
        }

        function goPage(p) {
            const totalPages = Math.ceil(filtered.length / pageSize);
            if (p < 1 || p > totalPages) return;
            currentPage = p;
            renderTable();
        }

        function applyFilters() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const status = document.getElementById('statusFilter').value;

            filtered = allCargos.filter(c => {
                const matchSearch = !search || c.TrackingNumber.toLowerCase().includes(search) || c.OrderId.toLowerCase().includes(search);
                const matchStatus = !status || c.Status === status;
                return matchSearch && matchStatus;
            });

            currentPage = 1;
            renderTable();
        }

        document.addEventListener('DOMContentLoaded', () => renderTable());
    </script>
}

<style>
    .page-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.4rem;
        font-weight: 800;
        color: var(--text);
        letter-spacing: -0.01em;
    }

    .page-sub {
        font-size: 0.82rem;
        color: var(--text-muted);
        margin-top: 0.3rem;
    }

    .stat-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .stat-mini {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.1rem 1.5rem;
        box-shadow: var(--shadow);
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: box-shadow 0.2s;
    }

        .stat-mini:hover {
            box-shadow: var(--shadow-md);
        }

    .stat-mini-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .stat-mini-value {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--text);
        line-height: 1;
    }

    .stat-mini-label {
        font-size: 0.72rem;
        color: var(--text-muted);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-top: 0.15rem;
    }

    .table-wrap {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .table-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.1rem 1.5rem;
        border-bottom: 1px solid var(--border);
        background: var(--surface2);
        gap: 1rem;
    }

    .toolbar-left {
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }

    .filter-select {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text);
        font-family: var(--font);
        font-size: 0.82rem;
        padding: 0.5rem 0.75rem;
        outline: none;
        cursor: pointer;
        transition: border-color 0.2s;
    }

        .filter-select:focus {
            border-color: var(--accent);
        }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead th {
        padding: 0.75rem 1.5rem;
        text-align: left;
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        background: var(--surface2);
        border-bottom: 1px solid var(--border);
    }

    tbody td {
        padding: 0.9rem 1.5rem;
        border-bottom: 1px solid var(--border);
        vertical-align: middle;
        font-size: 0.85rem;
        color: var(--text-dim);
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    tbody tr:hover td {
        background: #fafbff;
    }

    .table-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.5rem;
        border-top: 1px solid var(--border);
        background: var(--surface2);
        font-size: 0.78rem;
        color: var(--text-muted);
    }

    .pagination {
        display: flex;
        gap: 0.3rem;
        align-items: center;
    }

    .page-btn {
        width: 30px;
        height: 30px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        color: var(--text-dim);
        font-size: 0.78rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s;
    }

        .page-btn:hover:not(:disabled) {
            background: var(--accent-bg);
            color: var(--accent);
            border-color: rgba(66,122,181,0.3);
        }

        .page-btn.active {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent);
        }

        .page-btn:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }
</style>

<!-- HEADER -->
<div class="page-header">
    <div>
        <div class="page-title">Kargo Takibi</div>
        <div class="page-sub">Tüm kargo kayıtlarını görüntüleyin</div>
    </div>
</div>

<!-- STAT CARDS -->
<div class="stat-row">
    <div class="stat-mini">
        <div class="stat-mini-icon icon-blue"><i class="fas fa-truck"></i></div>
        <div>
            <div class="stat-mini-value">@ViewBag.TotalCargos</div>
            <div class="stat-mini-label">Toplam Kargo</div>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-mini-icon icon-yellow"><i class="fas fa-box"></i></div>
        <div>
            <div class="stat-mini-value">@ViewBag.PreparingCargos</div>
            <div class="stat-mini-label">Hazırlanıyor</div>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-mini-icon" style="background:rgba(52,152,219,0.1);color:#3498db"><i class="fas fa-shipping-fast"></i></div>
        <div>
            <div class="stat-mini-value">@ViewBag.ShippedCargos</div>
            <div class="stat-mini-label">Kargoda</div>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-mini-icon icon-green"><i class="fas fa-circle-check"></i></div>
        <div>
            <div class="stat-mini-value">@ViewBag.DeliveredCargos</div>
            <div class="stat-mini-label">Teslim Edildi</div>
        </div>
    </div>
</div>

<!-- TABLO -->
<div class="table-wrap">
    <div class="table-toolbar">
        <div class="toolbar-left">
            <input type="text" id="searchInput" class="search-input" placeholder="Takip no veya sipariş no ara..." oninput="applyFilters()" style="width:260px" />
            <select id="statusFilter" class="filter-select" onchange="applyFilters()">
                <option value="">Tüm Durumlar</option>
                <option value="Preparing">Hazırlanıyor</option>
                <option value="Shipped">Kargoda</option>
                <option value="Delivered">Teslim Edildi</option>
            </select>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Takip Numarası</th>
                <th>Sipariş No</th>
                <th>Durum</th>
                <th>Oluşturulma Tarihi</th>
                <th>Kargo ID</th>
            </tr>
        </thead>
        <tbody id="cargoTbody">
            <tr>
                <td colspan="5" style="text-align:center;padding:2rem;color:var(--text-muted)">
                    <i class="fas fa-spinner fa-spin"></i> Yükleniyor...
                </td>
            </tr>
        </tbody>
    </table>

    <div class="table-footer">
        <span id="paginationInfo"></span>
        <div class="pagination" id="pagination"></div>
    </div>
</div>
