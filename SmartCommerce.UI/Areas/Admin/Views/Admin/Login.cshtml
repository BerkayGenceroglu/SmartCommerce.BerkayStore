@{
    ViewData["Title"] = "Admin Girişi";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Girişi — Berkay Store</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg-main: #0f172a;
            --surface: #ffffff;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --border-color: #e2e8f0;
            --font: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            font-family: var(--font);
            background-color: #f8fafc;
            min-height: 100vh;
            display: grid;
            grid-template-columns: 1.2fr 1fr;
        }

        /* ── SOL BÖLÜM: PREMİUM GÖRSEL ALAN ── */
        .login-left {
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 4rem;
            background-color: var(--bg-main);
        }

        .login-left-bg {
            position: absolute;
            inset: 0;
            background-image: url('https://images.unsplash.com/photo-1486325212027-8081e485255e?w=1200&auto=format&fit=crop&q=80');
            background-size: cover;
            background-position: center;
            opacity: 0.25;
            filter: grayscale(40%);
        }

        .login-left-content {
            position: relative;
            z-index: 2;
            max-width: 520px;
            margin: auto 0;
        }

        .left-badge {
            display: inline-block;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #94a3b8;
            font-size: 0.75rem;
            font-weight: 600;
            letter-spacing: 0.05em;
            padding: 0.35rem 0.85rem;
            border-radius: 6px;
            margin-bottom: 2rem;
        }

        .left-title {
            font-size: clamp(2.2rem, 3.5vw, 3.2rem);
            font-weight: 700;
            color: #f8fafc;
            line-height: 1.15;
            letter-spacing: -0.03em;
            margin-bottom: 1.5rem;
        }

            .left-title span {
                color: #38bdf8;
                font-weight: 400;
            }

        .left-sub {
            font-size: 1.05rem;
            color: #94a3b8;
            line-height: 1.6;
        }

        .login-left-footer {
            position: relative;
            z-index: 2;
            color: #475569;
            font-size: 0.8rem;
            font-weight: 500;
        }

        /* ── SAĞ BÖLÜM: MİNİMAL FORM ALANI ── */
        .login-right {
            background: var(--surface);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 4rem 3rem;
            border-left: 1px solid var(--border-color);
        }

        .login-form-wrap {
            width: 100%;
            max-width: 380px;
        }

        .brand-area {
            margin-bottom: 3.5rem;
        }

        .brand-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--text-main);
            letter-spacing: -0.02em;
        }

        .brand-subtitle {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin-top: 0.15rem;
        }

        .form-header {
            margin-bottom: 2rem;
        }

        .form-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-main);
            letter-spacing: -0.02em;
            margin-bottom: 0.4rem;
        }

        .form-subtitle {
            font-size: 0.875rem;
            color: var(--text-muted);
        }

        .form-group {
            margin-bottom: 1.25rem;
        }

        .form-label {
            display: block;
            font-size: 0.8rem;
            font-weight: 600;
            color: #475569;
            margin-bottom: 0.5rem;
        }

        .input-wrap {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 0.9rem;
            pointer-events: none;
        }

        .form-input {
            width: 100%;
            background: #fff;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            color: var(--text-main);
            font-family: var(--font);
            font-size: 0.92rem;
            padding: 0.75rem 1rem 0.75rem 2.5rem;
            outline: none;
            transition: all 0.15s ease-in-out;
        }

            .form-input:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
            }

            .form-input::placeholder {
                color: #94a3b8;
            }

        /* Hata Mesajı Bölümü */
        .error-msg {
            background: #fef2f2;
            border: 1px solid #fee2e2;
            border-radius: 8px;
            color: #991b1b;
            font-size: 0.85rem;
            font-weight: 500;
            padding: 0.8rem 1rem;
            margin-bottom: 1.5rem;
            display: none;
            align-items: center;
            gap: 0.6rem;
        }

            .error-msg.show {
                display: flex;
            }

        /* Giriş Butonu */
        .btn-login {
            width: 100%;
            background: var(--primary);
            color: #fff;
            border: none;
            border-radius: 8px;
            font-family: var(--font);
            font-weight: 600;
            font-size: 0.92rem;
            padding: 0.85rem;
            cursor: pointer;
            transition: all 0.15s ease-in-out;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            margin-top: 1.75rem;
        }

            .btn-login:hover {
                background: var(--primary-hover);
            }

            .btn-login:disabled {
                opacity: 0.6;
                cursor: not-allowed;
            }

        .login-footer {
            margin-top: 2rem;
            text-align: center;
        }

            .login-footer a {
                font-size: 0.85rem;
                color: var(--text-muted);
                text-decoration: none;
                font-weight: 500;
                transition: color 0.15s;
            }

                .login-footer a:hover {
                    color: var(--text-main);
                }

        /* Responsive */
        @@media (max-width: 992px) {
            body {
                grid-template-columns: 1fr;
            }

            .login-left {
                display: none;
            }

            .login-right {
                padding: 2rem 1.5rem;
            }
        }
    </style>
</head>
<body>

    <div class="login-left">
        <div class="login-left-bg"></div>
        <div class="login-left-content">
            <div class="left-badge">Yönetim Paneli</div>
            <h1 class="left-title">Berkay Store<br><span>Yönetim Merkezi</span></h1>
            <p class="left-sub">Mağaza performansını izleyin, envanterinizi ve sipariş süreçlerinizi tek bir merkezden organize edin.</p>
        </div>
        <div class="login-left-footer">
            &copy; @DateTime.Now.Year Berkay Store. Tüm hakları saklıdır.
        </div>
    </div>

    <div class="login-right">
        <div class="login-form-wrap">

            <div class="form-header">
                <h2 class="form-title">Oturum Açın</h2>
                <p class="form-subtitle">Devam etmek için kimliğinizi doğrulayın.</p>
            </div>

            <div class="error-msg" id="errorMsg">
                <i class="fas fa-exclamation-circle"></i>
                <span id="errorText">Geçersiz e-posta veya şifre.</span>
            </div>

            <div class="form-group">
                <label class="form-label">E-posta Adresi</label>
                <div class="input-wrap">
                    <i class="far fa-envelope input-icon"></i>
                    <input type="email" class="form-input" id="email" placeholder="isim@berkaystore.com" spellcheck="false" autocomplete="email" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Şifre</label>
                <div class="input-wrap">
                    <i class="bg-icon far fa-lock input-icon"></i>
                    <input type="password" class="form-input" id="password" placeholder="••••••••" />
                </div>
            </div>

            <button class="btn-login" id="loginBtn" onclick="doLogin()">
                Giriş Yap
            </button>

            <div class="login-footer">
                <a href="/"><i class="fas fa-arrow-left" style="font-size:0.75rem; margin-right:4px;"></i> Web Sitesine Dön</a>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('keydown', e => { if (e.key === 'Enter') doLogin(); });

        async function doLogin() {
            const email = document.getElementById('email').value.trim();
            const password = document.getElementById('password').value;
            const btn = document.getElementById('loginBtn');
            const errorMsg = document.getElementById('errorMsg');
            const errorText = document.getElementById('errorText');

            if (!email || !password) {
                errorText.textContent = 'Lütfen gerekli alanları doldurun.';
                errorMsg.classList.add('show');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            errorMsg.classList.remove('show');

            try {
                const res = await fetch('https://localhost:7038/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, password })
                });

                if (res.ok) {
                    const data = await res.json();
                    const payload = JSON.parse(atob(data.token.split('.')[1]));
                    const role = payload['http://schemas.microsoft.com/ws/2008/06/identity/claims/role'];

                    if (role !== 'Admin') {
                        errorText.textContent = 'Bu alana erişim yetkiniz bulunmamaktadır.';
                        errorMsg.classList.add('show');
                        btn.disabled = false;
                        btn.innerHTML = 'Giriş Yap';
                        return;
                    }

                    sessionStorage.setItem('adminToken', data.token);
                    sessionStorage.setItem('adminName', data.fullName);

                    await fetch('/Admin/Admin/SaveSession', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                        body: `token=${encodeURIComponent(data.token)}&name=${encodeURIComponent(data.fullName)}`
                    });

                    btn.innerHTML = 'Doğrulandı, yönlendiriliyorsunuz...';
                    btn.style.background = '#10b981';
                    setTimeout(() => window.location.href = '/Admin/Admin/Dashboard', 600);
                } else {
                    errorText.textContent = 'E-posta adresi veya şifre hatalı.';
                    errorMsg.classList.add('show');
                    btn.disabled = false;
                    btn.innerHTML = 'Giriş Yap';
                }
            } catch (e) {
                errorText.textContent = 'Sunucuyla bağlantı kurulamadı.';
                errorMsg.classList.add('show');
                btn.disabled = false;
                btn.innerHTML = 'Giriş Yap';
            }
        }
    </script>
</body>
</html>