@model SmartCommerce.UI.Models.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .auth-page {
        min-height: calc(100vh - 96px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 1rem;
    }

    .auth-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        max-width: 900px;
        width: 100%;
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
    }

    .auth-visual {
        background: var(--surface);
        padding: 3rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        overflow: hidden;
    }

        .auth-visual::before {
            content: '';
            position: absolute;
            top: -60px;
            right: -60px;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: var(--accent);
            opacity: 0.08;
        }

        .auth-visual::after {
            content: '';
            position: absolute;
            bottom: -40px;
            left: -40px;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: var(--accent2);
            opacity: 0.08;
        }

    .auth-visual-logo {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 1.5rem;
        color: var(--text);
    }

        .auth-visual-logo span {
            color: var(--accent);
        }

    .auth-visual-content h2 {
        font-family: var(--font-display);
        font-size: 2rem;
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 1rem;
        color: var(--text);
    }

    .auth-visual-content p {
        color: var(--text-muted);
        font-size: 0.9rem;
        line-height: 1.7;
    }

    .auth-visual-stats {
        display: flex;
        gap: 2rem;
    }

    .auth-stat-item h3 {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--accent);
    }

    .auth-stat-item p {
        font-size: 0.75rem;
        color: var(--text-muted);
    }

    .auth-form {
        background: var(--bg);
        padding: 3rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .auth-form h1 {
            font-family: var(--font-display);
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.4rem;
            color: var(--text);
        }

        .auth-form .subtitle {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin-bottom: 2rem;
        }

            .auth-form .subtitle a {
                color: var(--accent);
                text-decoration: none;
            }

    .form-group {
        margin-bottom: 1.25rem;
    }

        .form-group label {
            display: block;
            font-size: 0.78rem;
            font-weight: 500;
            color: var(--text-dim);
            margin-bottom: 0.4rem;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .form-group input {
            width: 100%;
            background: var(--surface2);
            border: 1px solid var(--border);
            color: var(--text);
            font-family: var(--font-body);
            font-size: 0.9rem;
            font-weight: 300;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            outline: none;
            transition: border-color 0.2s;
        }

            .form-group input:focus {
                border-color: var(--accent);
            }

            .form-group input::placeholder {
                color: var(--text-muted);
            }

    .btn-submit {
        width: 100%;
        background: var(--accent);
        color: #000;
        border: none;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.9rem;
        letter-spacing: 0.05em;
        padding: 0.85rem;
        border-radius: 8px;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.1s;
        margin-top: 0.5rem;
    }

        .btn-submit:hover {
            opacity: 0.88;
            transform: translateY(-1px);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

    .error-msg {
        background: rgba(255,80,80,0.1);
        border: 1px solid rgba(255,80,80,0.3);
        color: #ff8080;
        font-size: 0.82rem;
        padding: 0.65rem 1rem;
        border-radius: 6px;
        margin-bottom: 1rem;
    }
</style>

<div class="auth-page">
    <div class="auth-container">
        <div class="auth-visual">
            <div class="auth-visual-logo">Berkay Store<span>.</span></div>
            <div class="auth-visual-content">
                <h2>Alışverişin yeni deneyimi</h2>
                <p>Binlerce ürün, güvenli ödeme ve hızlı teslimat ile modern alışveriş deneyimini keşfet.</p>
            </div>
            <div class="auth-visual-stats">
                <div class="auth-stat-item">
                    <h3>10K+</h3>
                    <p>Ürün</p>
                </div>
                <div class="auth-stat-item">
                    <h3>50K+</h3>
                    <p>Müşteri</p>
                </div>
                <div class="auth-stat-item">
                    <h3>99%</h3>
                    <p>Memnuniyet</p>
                </div>
            </div>
        </div>

        <div class="auth-form">
            <h1>Hoş geldin</h1>
            <p class="subtitle">Hesabın yok mu? <a href="/Auth/Register">Üye ol</a></p>

            @if (ViewBag.Error != null)
            {
                <div class="error-msg">
                    <i class="fas fa-circle-exclamation"></i> @ViewBag.Error
                </div>
            }

            <form method="post" action="/Auth/Login">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>E-posta</label>
                    <input type="email" name="Email" placeholder="ornek@gmail.com" required />
                </div>
                <div class="form-group">
                    <label>Şifre</label>
                    <input type="password" name="Password" placeholder="••••••••" required />
                </div>
                <button type="submit" class="btn-submit">Giriş Yap →</button>
            </form>
        </div>
    </div>
</div>