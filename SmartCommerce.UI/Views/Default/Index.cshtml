@{
    ViewData["Title"] = "Berkay Store - Modern Alışverişin Yeni Adresi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    /* ── HERO (Premium & Modern E-Commerce Edit) ── */
    .hero {
        position: relative;
        min-height: 580px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 4rem 2rem;
        background: #0f172a; /* Derin Gece Mavisi Zemin */
    }

    .hero-bg {
        position: absolute;
        inset: 0;
        background-image: url('https://images.unsplash.com/photo-1604028289433-26eec51aae02?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D');
        background-size: cover;
        background-position: center;
        filter: brightness(0.4);
        transform: scale(1.02);
        transition: transform 6s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .hero:hover .hero-bg {
        transform: scale(1.0);
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.9) 0%, rgba(30, 41, 59, 0.4) 50%, rgba(15, 23, 42, 0.95) 100%);
    }

    .hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
        max-width: 750px;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #f8fafc;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        padding: 0.5rem 1.2rem;
        border-radius: 30px;
        margin-bottom: 1.8rem;
        backdrop-filter: blur(8px);
    }

        .hero-eyebrow i {
            color: #3b82f6; /* Soft Mavi İkon */
            font-size: 0.8rem;
        }

    .hero-title {
        font-family: var(--font-display), system-ui, sans-serif;
        font-size: clamp(2.4rem, 5.5vw, 4.2rem);
        font-weight: 800;
        color: #ffffff;
        line-height: 1.15;
        margin-bottom: 1.2rem;
        letter-spacing: -0.03em;
    }

        .hero-title .accent {
            color: #2d9e5f; /* İstediğiniz modern yeşil tonu */
            background: none;
            -webkit-background-clip: unset;
            -webkit-text-fill-color: unset;
        }

    .hero-subtitle {
        font-size: 1.1rem;
        color: #94a3b8;
        margin-bottom: 2.5rem;
        line-height: 1.6;
        font-weight: 400;
    }
    /* ── SEARCH ── */
    .search-wrap {
        max-width: 620px;
        margin: 0 auto;
        position: relative;
    }

    .search-box {
        display: flex;
        align-items: center;
        background: #ffffff;
        border-radius: 16px;
        padding: 0.6rem 0.6rem 0.6rem 1.5rem;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
        gap: 0.75rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

        .search-box input {
            flex: 1;
            border: none;
            outline: none;
            font-family: var(--font-body), system-ui, sans-serif;
            font-size: 1rem;
            color: #0f172a;
            background: transparent;
        }

            .search-box input::placeholder {
                color: #94a3b8;
            }

    .btn-search {
        background: #1e293b; /* Tok Lacivert/Siyah Tonu */
        color: #ffffff;
        border: none;
        font-family: var(--font-display), system-ui, sans-serif;
        font-weight: 600;
        font-size: 0.9rem;
        padding: 0.85rem 1.8rem;
        border-radius: 12px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: background 0.2s, transform 0.1s;
        white-space: nowrap;
    }

        .btn-search:hover {
            background: #0f172a;
            transform: translateY(-1px);
        }
    /* ── SEARCH DROPDOWN ── */
    .search-results {
        position: absolute;
        top: calc(100% + 10px);
        left: 0;
        right: 0;
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 20px 60px rgba(0,0,0,0.18);
        z-index: 100;
        max-height: 420px;
        overflow-y: auto;
        display: none;
        scrollbar-width: none;
    }

        .search-results::-webkit-scrollbar {
            display: none;
        }

    .search-result-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.85rem 1.25rem;
        cursor: pointer;
        transition: background 0.15s;
        text-decoration: none;
        color: inherit;
        border-bottom: 1px solid #f5f5f5;
    }

        .search-result-item:last-child {
            border-bottom: none;
        }

        .search-result-item:hover {
            background: #f9fafb;
        }

    .search-result-img {
        width: 48px;
        height: 48px;
        border-radius: 8px;
        background: #f0f0f0;
        overflow: hidden;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: #ccc;
    }

        .search-result-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .search-result-info {
        flex: 1;
        min-width: 0;
    }

    .search-result-name {
        font-size: 0.88rem;
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: 0.15rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .search-result-meta {
        font-size: 0.72rem;
        color: #999;
    }

    .search-result-price {
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--accent);
        flex-shrink: 0;
    }

    .search-no-result {
        padding: 2rem;
        text-align: center;
        color: #aaa;
        font-size: 0.88rem;
    }

    .search-loading {
        padding: 1.5rem;
        text-align: center;
        color: #aaa;
        font-size: 0.85rem;
    }
    /* ── STATS BAR ── */
    .stats-bar {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        padding: 1rem 2rem;
    }

    .stats-inner {
        max-width: 1400px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 3rem;
    }

    .stat-item {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 0.82rem;
        color: var(--text-dim);
    }

        .stat-item i {
            color: var(--accent);
            font-size: 0.9rem;
        }

        .stat-item strong {
            color: var(--text);
            font-weight: 700;
        }

    .stat-divider {
        width: 1px;
        height: 20px;
        background: var(--border);
    }
    /* ── MAIN ── */
    .home-content {
        max-width: 1400px;
        margin: 0 auto;
        padding: 4rem 2rem;
    }
    /* ── KATEGORİ SECTION ── */
    .category-section {
        margin-bottom: 5rem;
    }

    .category-section-header {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 1.5rem;
        align-items: stretch;
        margin-bottom: 0;
    }

    .category-hero-card {
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        min-height: 260px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 1.5rem;
        text-decoration: none;
        cursor: pointer;
        flex-shrink: 0;
    }

    .category-hero-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        transition: transform 0.5s ease;
    }

    .category-hero-card:hover .category-hero-bg {
        transform: scale(1.06);
    }

    .category-hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.88) 0%, rgba(0,0,0,0.15) 60%, transparent 100%);
    }

    .category-hero-content {
        position: relative;
        z-index: 1;
    }

    .category-hero-tag {
        display: inline-block;
        background: var(--accent);
        color: #fff;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 0.2rem 0.55rem;
        border-radius: 4px;
        margin-bottom: 0.45rem;
    }

    .category-hero-name {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 800;
        color: #fff;
        line-height: 1.1;
        margin-bottom: 0.3rem;
    }

    .category-hero-count {
        font-size: 0.75rem;
        color: rgba(255,255,255,0.65);
    }

    .category-hero-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.7rem;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.25);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.38rem 0.8rem;
        border-radius: 6px;
        backdrop-filter: blur(4px);
        transition: background 0.2s;
    }

    .category-hero-card:hover .category-hero-btn {
        background: rgba(255,255,255,0.25);
    }
    /* ── ÜRÜN GRID ── */
    .category-products {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1rem;
    }

    .product-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
        text-decoration: none;
        color: inherit;
        display: block;
    }

        .product-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        }

    .product-img {
        aspect-ratio: 1;
        background: var(--surface2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        color: var(--border);
        overflow: hidden;
        position: relative;
    }

        .product-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s;
        }

    .product-card:hover .product-img img {
        transform: scale(1.06);
    }

    .product-info {
        padding: 0.85rem;
    }

    .product-brand {
        font-size: 0.62rem;
        color: var(--accent);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 0.2rem;
    }

    .product-name {
        font-family: var(--font-display);
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 0.4rem;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .product-price {
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 800;
        color: var(--accent);
    }

    .product-footer {
        padding: 0 0.85rem 0.85rem;
    }

    .btn-add-cart {
        width: 100%;
        background: var(--accent);
        color: #fff;
        border: none;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.72rem;
        padding: 0.55rem;
        border-radius: 7px;
        cursor: pointer;
        transition: opacity 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        text-decoration: none;
    }

        .btn-add-cart:hover {
            opacity: 0.88;
        }

        .btn-add-cart.incele {
            background: var(--surface2);
            color: var(--text-dim);
            border: 1px solid var(--border);
        }

            .btn-add-cart.incele:hover {
                background: var(--border);
                opacity: 1;
            }
    /* ── BÖLÜM AYIRICI ── */
    .section-divider {
        height: 1px;
        background: linear-gradient(to right, transparent, var(--border), transparent);
        margin: 0 0 5rem;
    }
    /* ── İNDİRİM BANNERLARI ── */
    .discounts-section {
        margin-bottom: 5rem;
    }

    .discounts-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin-bottom: 1.5rem;
    }

    .discounts-title {
        font-family: var(--font-display);
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--text);
        letter-spacing: -0.01em;
    }

    .discounts-subtitle {
        font-size: 0.82rem;
        color: var(--text-muted);
        margin-top: 0.2rem;
    }

    .discounts-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr;
        gap: 1rem;
    }

    .discount-card {
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        text-decoration: none;
        display: block;
        cursor: pointer;
    }

    .discount-card-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        transition: transform 0.5s ease;
        filter: brightness(0.52);
    }

    .discount-card:hover .discount-card-bg {
        transform: scale(1.07);
        filter: brightness(0.42);
    }

    .discount-card-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(145deg, rgba(0,0,0,0.55) 0%, transparent 65%);
    }

    .discount-card-content {
        position: relative;
        z-index: 1;
        padding: 2rem;
        min-height: 200px;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
    }

    .discount-card.large .discount-card-content {
        min-height: 280px;
    }

    .discount-badge {
        display: inline-block;
        background: #e74c3c;
        color: #fff;
        font-size: 0.62rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        padding: 0.22rem 0.6rem;
        border-radius: 4px;
        margin-bottom: 0.55rem;
        width: fit-content;
    }

    .discount-title {
        font-family: var(--font-display);
        font-size: 1.6rem;
        font-weight: 800;
        color: #fff;
        line-height: 1.1;
        margin-bottom: 0.3rem;
    }

    .discount-card:not(.large) .discount-title {
        font-size: 1.15rem;
    }

    .discount-sub {
        font-size: 0.78rem;
        color: rgba(255,255,255,0.7);
        margin-bottom: 1rem;
    }

    .discount-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(255,255,255,0.95);
        color: #1a1a1a;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.75rem;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        width: fit-content;
        transition: background 0.2s;
    }

    .discount-card:hover .discount-btn {
        background: #fff;
    }
    /* ── SKELETON ── */
    .skeleton {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        animation: pulse 1.5s ease-in-out infinite;
    }

    .skeleton-img {
        aspect-ratio: 1;
        background: var(--surface2);
    }

    .skeleton-info {
        padding: 0.85rem;
    }

    .skeleton-line {
        height: 9px;
        background: var(--surface2);
        border-radius: 4px;
        margin-bottom: 0.5rem;
    }

        .skeleton-line.short {
            width: 55%;
        }

        .skeleton-line.medium {
            width: 80%;
        }

    .skeleton-hero {
        border-radius: 16px;
        min-height: 260px;
        background: var(--surface2);
        animation: pulse 1.5s ease-in-out infinite;
    }
    @@keyframes pulse {
        0%, 100%

    {
        opacity: 1;
    }

    50% {
        opacity: 0.6;
    }

    }
</style>

<section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <div class="hero-eyebrow">
            <i class="fas fa-sparkles"></i> 200+ Seçkin Ürün · Hızlı Teslimat · Güvenli Ödeme
        </div>
        <h1 class="hero-title">Modern alışverişin<br><span class="accent">Yeni Deneyimi</span></h1>
        <p class="hero-subtitle">Elektronikten modaya, spordan ev yaşamına trend ürünler<br>güvenilir altyapı ve avantajlı fiyatlarla kapınızda.</p>
        <div class="search-wrap">
            <div class="search-box">
                <i class="fas fa-search" style="color:#94a3b8; font-size:1rem; flex-shrink:0"></i>
                <input type="text" id="heroSearch" placeholder="Aradığınız ürün, kategori veya markayı yazın..." autocomplete="off" />
                <button class="btn-search" onclick="doSearch()">
                    <i class="fas fa-search"></i> Mağazada Ara
                </button>
            </div>
            <div class="search-results" id="searchResults"></div>
        </div>
    </div>
</section>

<div class="stats-bar">
    <div class="stats-inner">
        <div class="stat-item"><i class="fas fa-truck"></i><span><strong>500₺</strong> üzeri ücretsiz kargo</span></div>
        <div class="stat-divider"></div>
        <div class="stat-item"><i class="fas fa-rotate-left"></i><span><strong>30 gün</strong> iade garantisi</span></div>
        <div class="stat-divider"></div>
        <div class="stat-item"><i class="fas fa-shield-halved"></i><span><strong>256-bit SSL</strong> güvenli ödeme</span></div>
        <div class="stat-divider"></div>
        <div class="stat-item"><i class="fas fa-headset"></i><span><strong>7/24</strong> müşteri desteği</span></div>
    </div>
</div>

<div class="home-content" id="homeContent">
    <div style="display:grid;grid-template-columns:280px 1fr;gap:1.5rem;margin-bottom:2rem">
        <div class="skeleton-hero"></div>
        <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:1rem;align-content:start">
            @for (int i = 0; i < 5; i++)
            {
                <div class="skeleton">
                    <div class="skeleton-img"></div>
                    <div class="skeleton-info">
                        <div class="skeleton-line short"></div>
                        <div class="skeleton-line medium"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const token = '@Context.Session.GetString("Token")';
        const CATEGORIES = [
            { name: 'Elektronik', icon: 'fa-mobile-screen', image: 'https://images.unsplash.com/photo-1468495244123-6c6c332eeece?w=600&auto=format&fit=crop&q=80', desc: 'Akıllı cihazlar & teknoloji' },
            { name: 'Giyim', icon: 'fa-shirt', image: 'https://images.unsplash.com/photo-1441984904996-e0b6ba687e04?w=600&auto=format&fit=crop&q=80', desc: 'Moda & sezon trendleri' },
            { name: 'Spor', icon: 'fa-dumbbell', image: 'https://images.unsplash.com/photo-1517838277536-f5f99be501cd?w=600&auto=format&fit=crop&q=80', desc: 'Ekipman & spor giyim' },
            { name: 'Bakım & Kozmetik', icon: 'fa-pump-soap', image: 'https://images.unsplash.com/photo-1596462502278-27bfdc403348?w=600&auto=format&fit=crop&q=80', desc: 'Cilt bakımı & güzellik' },
            { name: 'Ev & Yaşam', icon: 'fa-couch', image: 'https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=600&auto=format&fit=crop&q=80', desc: 'Mutfak & ev aletleri' },
            { name: 'Kitap', icon: 'fa-book', image: 'https://images.unsplash.com/photo-1481627834876-b7833e8f5570?w=600&auto=format&fit=crop&q=80', desc: 'Roman, kişisel gelişim & daha fazlası' },
            { name: 'Evcil Hayvan', icon: 'fa-paw', image: 'https://images.unsplash.com/photo-1450778869180-41d0601e046e?w=600&auto=format&fit=crop&q=80', desc: 'Mama, oyuncak & aksesuar' }
        ];
        const DISCOUNTS = [
            {
                large: true,
                bg: 'https://images.unsplash.com/photo-1477959858617-67f85cf4f1df?w=900&auto=format&fit=crop&q=80',
                badge: 'Haftalık Fırsat',
                title: 'Elektronik\nSezonunda',
                sub: 'Seçili ürünlerde özel fiyatlar',
                link: '/Product?category=Elektronik'
            },
            {
                large: false,
                bg: 'https://images.unsplash.com/photo-1519501025264-65ba15a82390?w=700&auto=format&fit=crop&q=80',
                badge: 'Yeni Sezon',
                title: 'Moda & Stil',
                sub: 'Trend parçalar seni bekliyor',
                link: '/Product?category=Giyim'
            },
            {
                large: false,
                bg: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=700&auto=format&fit=crop&q=80',
                badge: 'Spor & Sağlık',
                title: 'Aktif Yaşam',
                sub: 'Spor ekipmanlarında indirim',
                link: '/Product?category=Spor'
            }
        ];
        const categoryIcons = {
            'Elektronik': 'fa-mobile-screen', 'Giyim': 'fa-shirt', 'Spor': 'fa-dumbbell',
            'Bakım & Kozmetik': 'fa-pump-soap', 'Ev & Yaşam': 'fa-couch', 'Kitap': 'fa-book', 'Evcil Hayvan': 'fa-paw'
        };

        // ── SEARCH ──
        let searchTimeout = null;
        document.getElementById('heroSearch').addEventListener('input', function() {
            clearTimeout(searchTimeout);
            const q = this.value.trim();
            if (q.length < 2) { document.getElementById('searchResults').style.display = 'none'; return; }
            searchTimeout = setTimeout(() => liveSearch(q), 300);
        });
        document.getElementById('heroSearch').addEventListener('keydown', function(e) {
            if (e.key === 'Enter') doSearch();
            if (e.key === 'Escape') document.getElementById('searchResults').style.display = 'none';
        });
        document.addEventListener('click', function(e) {
            if (!e.target.closest('.search-wrap')) document.getElementById('searchResults').style.display = 'none';
        });

        async function liveSearch(q) {
            const resultsEl = document.getElementById('searchResults');
            resultsEl.style.display = 'block';
            resultsEl.innerHTML = `<div class="search-loading"><i class="fas fa-spinner fa-spin"></i> Aranıyor...</div>`;
            try {
                const res = await fetch(`https://localhost:7136/api/product/search?q=${encodeURIComponent(q)}`);
                const products = await res.json();
                if (!products || products.length === 0) {
                    resultsEl.innerHTML = `<div class="search-no-result"><i class="fas fa-search" style="font-size:1.5rem;display:block;margin-bottom:0.5rem"></i>Sonuç bulunamadı</div>`;
                    return;
                }
                resultsEl.innerHTML = products.slice(0, 8).map(p => `
                    <a href="/Product/Detail/${p.id}" class="search-result-item">
                        <div class="search-result-img">
                            ${p.imageUrl ? `<img src="${p.imageUrl}" alt="${p.name}" onerror="this.style.display='none'" />` : `<i class="fas ${categoryIcons[p.categoryName] || 'fa-box'}"></i>`}
                        </div>
                        <div class="search-result-info">
                            <div class="search-result-name">${p.name}</div>
                            <div class="search-result-meta">${p.brand || ''} · ${p.categoryName}</div>
                        </div>
                        <div class="search-result-price">${p.price.toLocaleString('tr-TR')}₺</div>
                    </a>
                `).join('');
            } catch (e) { resultsEl.style.display = 'none'; }
        }

        function doSearch() {
            const q = document.getElementById('heroSearch').value.trim();
            if (q) window.location.href = `/Product?search=${encodeURIComponent(q)}`;
        }

        // ── BANNER HTML ──
        function renderDiscountBanners() {
            return `
                <div class="discounts-section">
                    <div class="discounts-header">
                        <div>
                            <div class="discounts-title">Kampanyalar & Fırsatlar</div>
                            <div class="discounts-subtitle">Sınırlı süreli özel teklifler</div>
                        </div>
                    </div>
                    <div class="discounts-grid">
                        ${DISCOUNTS.map(d => `
                            <a href="${d.link}" class="discount-card ${d.large ? 'large' : ''}">
                                <div class="discount-card-bg" style="background-image:url('${d.bg}')"></div>
                                <div class="discount-card-overlay"></div>
                                <div class="discount-card-content">
                                    <span class="discount-badge">${d.badge}</span>
                                    <div class="discount-title">${d.title.replace('\n', '<br>')}</div>
                                    <div class="discount-sub">${d.sub}</div>
                                    <span class="discount-btn">Keşfet <i class="fas fa-arrow-right" style="font-size:0.65rem"></i></span>
                                </div>
                            </a>
                        `).join('')}
                    </div>
                </div>
                <div class="section-divider"></div>
            `;
        }

        // ── ANA SAYFA ──
        async function loadHome() {
            try {
                const res = await fetch('https://localhost:7136/api/product');
                const allProducts = await res.json();
                let html = renderDiscountBanners();
                CATEGORIES.forEach((cat, idx) => {
                    const catProducts = allProducts
                        .filter(p => p.categoryName === cat.name && p.stock > 0)
                        .slice(0, 5);
                    if (catProducts.length === 0) return;
                    html += `
                        <div class="category-section">
                            <div class="category-section-header">
                                <a href="/Product?category=${encodeURIComponent(cat.name)}" class="category-hero-card">
                                    <div class="category-hero-bg" style="background-image:url('${cat.image}')"></div>
                                    <div class="category-hero-overlay"></div>
                                    <div class="category-hero-content">
                                        <span class="category-hero-tag">${catProducts.length}+ Ürün</span>
                                        <div class="category-hero-name">${cat.name}</div>
                                        <div class="category-hero-count">${cat.desc}</div>
                                        <span class="category-hero-btn">Tümünü Gör <i class="fas fa-arrow-right" style="font-size:0.65rem"></i></span>
                                    </div>
                                </a>
                                <div class="category-products">
                                    ${catProducts.map(p => `
                                        <a href="/Product/Detail/${p.id}" class="product-card">
                                            <div class="product-img">
                                                ${p.imageUrl ? `<img src="${p.imageUrl}" alt="${p.name}" onerror="this.style.display='none'" />` : `<i class="fas ${categoryIcons[p.categoryName] || 'fa-box'}"></i>`}
                                            </div>
                                            <div class="product-info">
                                                <div class="product-brand">${p.brand || ''}</div>
                                                <div class="product-name">${p.name}</div>
                                                <div class="product-price">${p.price.toLocaleString('tr-TR')}₺</div>
                                            </div>
                                        <div class="product-footer">
                                            <button class="btn-add-cart" ${p.stock === 0 ? 'disabled' : ''} onclick="event.preventDefault(); addToCart('${p.id}', '${p.name.replace(/'/g, "\\'")}', ${p.price})">
                                                <i class="fas fa-bag-shopping"></i> ${p.stock === 0 ? 'Tükendi' : 'Sepete Ekle'}
                                            </button>
                                         </div>
                                        </a>
                                    `).join('')}
                                </div>
                            </div>
                        </div>
                        <div class="section-divider"></div>
                    `;
                });
                document.getElementById('homeContent').innerHTML = html;
                updateCartBadge();
            } catch (e) {
                document.getElementById('homeContent').innerHTML = `
                    <div style="text-align:center;padding:4rem;color:var(--text-muted)">
                        <i class="fas fa-triangle-exclamation" style="font-size:2rem;display:block;margin-bottom:1rem"></i>
                        Ürünler yüklenemedi.
                    </div>`;
            }
        }

        async function addToCart(productId, productName, unitPrice) {
            if (!token) { window.location.href = '/Auth/Login'; return; }
            try {
                const res = await fetch('https://localhost:7124/api/cart/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ productId, productName, unitPrice, quantity: 1 })
                });
                if (res.ok) { showToast(`${productName} sepete eklendi!`); updateCartBadge(); }
            } catch (e) { showToast('Bir hata oluştu.'); }
        }

        async function updateCartBadge() {
            if (!token) return;
            try {
                const res = await fetch('https://localhost:7124/api/cart', { headers: { 'Authorization': 'Bearer ' + token } });
                const cart = await res.json();
                const total = cart.items?.reduce((s, i) => s + i.quantity, 0) || 0;
                document.getElementById('cartCount').textContent = total;
            } catch (e) {}
        }

        loadHome();
    </script>
}