@{
    ViewData["Title"] = "Favorilerim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .favorites-page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2rem;
    }

    .favorites-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--border);
    }

        .favorites-header h1 {
            font-family: var(--font-display);
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text);
        }

            .favorites-header h1 span {
                font-size: 0.9rem;
                font-weight: 400;
                color: var(--text-muted);
                margin-left: 0.5rem;
            }

    /* ── FAV LIST ── */
    .fav-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .fav-item {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1rem;
        display: grid;
        grid-template-columns: 110px 1fr auto;
        gap: 1.25rem;
        align-items: center;
        transition: box-shadow 0.2s;
    }

        .fav-item:hover {
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
        }

    /* ── IMAGE ── */
    .fav-img {
        width: 110px;
        height: 110px;
        background: var(--surface2);
        border-radius: 10px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        color: var(--border);
        flex-shrink: 0;
        text-decoration: none;
    }

        .fav-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s;
        }

    .fav-item:hover .fav-img img {
        transform: scale(1.05);
    }

    /* ── INFO ── */
    .fav-info {
        min-width: 0;
    }

    .fav-brand {
        font-size: 0.7rem;
        font-weight: 700;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.25rem;
    }

    .fav-name {
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 0.3rem;
        line-height: 1.3;
        text-decoration: none;
        display: block;
        transition: color 0.2s;
    }

        .fav-name:hover {
            color: var(--accent);
        }

    .fav-category {
        display: inline-block;
        font-size: 0.7rem;
        color: var(--text-muted);
        background: var(--surface2);
        border: 1px solid var(--border);
        padding: 0.15rem 0.5rem;
        border-radius: 10px;
        margin-bottom: 0.5rem;
    }

    .fav-price {
        font-family: var(--font-display);
        font-size: 1.2rem;
        font-weight: 800;
        color: var(--accent);
        margin-bottom: 0.2rem;
    }

    .fav-stock {
        font-size: 0.72rem;
        color: var(--text-muted);
    }

    /* ── ACTIONS ── */
    .fav-actions {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        align-items: flex-end;
        flex-shrink: 0;
    }

    .btn-fav-cart {
        background: var(--accent);
        color: #fff;
        border: none;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.8rem;
        padding: 0.65rem 1.25rem;
        border-radius: 8px;
        cursor: pointer;
        transition: opacity 0.2s;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        white-space: nowrap;
    }

        .btn-fav-cart:hover {
            opacity: 0.88;
        }

        .btn-fav-cart:disabled {
            background: var(--surface2);
            color: var(--text-muted);
            cursor: not-allowed;
            opacity: 1;
        }

    .btn-remove-fav {
        background: none;
        border: 1px solid var(--border);
        color: var(--text-muted);
        font-size: 0.78rem;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        cursor: pointer;
        transition: border-color 0.2s, color 0.2s;
        display: flex;
        align-items: center;
        gap: 0.35rem;
        white-space: nowrap;
        font-family: var(--font-body);
    }

        .btn-remove-fav:hover {
            border-color: #e74c3c;
            color: #e74c3c;
        }

    .btn-fav-detail {
        background: none;
        border: 1px solid var(--border);
        color: var(--text-dim);
        font-size: 0.78rem;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        cursor: pointer;
        transition: border-color 0.2s, color 0.2s;
        display: flex;
        align-items: center;
        gap: 0.35rem;
        white-space: nowrap;
        text-decoration: none;
        font-family: var(--font-body);
    }

        .btn-fav-detail:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

    /* ── EMPTY ── */
    .empty-favorites {
        text-align: center;
        padding: 5rem 2rem;
    }

        .empty-favorites i {
            font-size: 4rem;
            color: var(--border);
            margin-bottom: 1.5rem;
            display: block;
        }

        .empty-favorites h2 {
            font-family: var(--font-display);
            font-size: 1.3rem;
            color: var(--text-dim);
            margin-bottom: 0.5rem;
        }

        .empty-favorites p {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 1.5rem;
        }

    .btn-shop {
        background: var(--accent);
        color: #fff;
        text-decoration: none;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        transition: opacity 0.2s;
        display: inline-block;
    }

        .btn-shop:hover {
            opacity: 0.88;
        }

    /* ── SKELETON ── */
    .skeleton-item {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1rem;
        display: grid;
        grid-template-columns: 110px 1fr auto;
        gap: 1.25rem;
        align-items: center;
        animation: pulse 1.5s ease-in-out infinite;
    }

    .skeleton-box {
        background: var(--surface2);
        border-radius: 10px;
    }

    .skeleton-line {
        height: 10px;
        background: var(--surface2);
        border-radius: 4px;
        margin-bottom: 0.5rem;
    }

        .skeleton-line.short {
            width: 40%;
        }

        .skeleton-line.medium {
            width: 65%;
        }

        .skeleton-line.long {
            width: 90%;
        }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.6;
        }
    }
</style>

<div class="favorites-page">
    <div class="favorites-header">
        <h1>Favorilerim <span id="favCount"></span></h1>
    </div>

    <div id="favoritesContent">
        @for (int i = 0; i < 3; i++)
        {
            <div class="skeleton-item" style="margin-bottom:1rem">
                <div class="skeleton-box" style="width:110px;height:110px"></div>
                <div>
                    <div class="skeleton-line short"></div>
                    <div class="skeleton-line long"></div>
                    <div class="skeleton-line medium"></div>
                </div>
                <div style="width:120px">
                    <div class="skeleton-line" style="height:36px;border-radius:8px"></div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        const token = '@Context.Session.GetString("Token")';

        const categoryIcons = {
            'Elektronik': 'fa-mobile-screen',
            'Giyim': 'fa-shirt',
            'Spor': 'fa-dumbbell',
            'Bakım & Kozmetik': 'fa-pump-soap',
            'Ev & Yaşam': 'fa-couch',
            'Kitap': 'fa-book',
            'Evcil Hayvan': 'fa-paw'
        };

        async function loadFavorites() {
            if (!token) {
                document.getElementById('favoritesContent').innerHTML = `
                    <div class="empty-favorites">
                        <i class="fas fa-heart-crack"></i>
                        <h2>Giriş yapmanız gerekiyor</h2>
                        <p>Favorilerinizi görmek için giriş yapın.</p>
                        <a href="/Auth/Login" class="btn-shop">Giriş Yap</a>
                    </div>`;
                return;
            }

            try {
                const res = await fetch('https://localhost:7136/api/favorites', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const favorites = await res.json();

                document.getElementById('favCount').textContent = `(${favorites.length} ürün)`;

                if (favorites.length === 0) {
                    document.getElementById('favoritesContent').innerHTML = `
                        <div class="empty-favorites">
                            <i class="fas fa-heart"></i>
                            <h2>Henüz favori ürününüz yok</h2>
                            <p>Beğendiğiniz ürünleri favorilere ekleyin.</p>
                            <a href="/Product" class="btn-shop">Alışverişe Başla</a>
                        </div>`;
                    return;
                }

                document.getElementById('favoritesContent').innerHTML = `
                    <div class="fav-list">
                        ${favorites.map(f => `
                            <div class="fav-item" id="fav_${f.productId}">
                                <a href="/Product/Detail/${f.productId}" class="fav-img">
                                    ${f.imageUrl
                                        ? `<img src="${f.imageUrl}" alt="${f.productName}" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" /><i class="fas ${categoryIcons[f.categoryName] || 'fa-box'}" style="display:none"></i>`
                                        : `<i class="fas ${categoryIcons[f.categoryName] || 'fa-box'}"></i>`
                                    }
                                </a>

                                <div class="fav-info">
                                    <div class="fav-brand">${f.brand || ''}</div>
                                    <a href="/Product/Detail/${f.productId}" class="fav-name">${f.productName}</a>
                                    <span class="fav-category">${f.categoryName}</span>
                                    <div class="fav-price">${f.price.toLocaleString('tr-TR')}₺</div>
                                    <div class="fav-stock">${f.stock > 0 ? `Stokta ${f.stock} adet` : '<span style="color:#e74c3c">Tükendi</span>'}</div>
                                </div>

                                <div class="fav-actions">
                                    <button class="btn-fav-cart" ${f.stock === 0 ? 'disabled' : ''} onclick="addToCart('${f.productId}', '${f.productName.replace(/'/g, "\\'")}', ${f.price})">
                                        <i class="fas fa-bag-shopping"></i>
                                        ${f.stock === 0 ? 'Tükendi' : 'Sepete Ekle'}
                                    </button>
                                    <a href="/Product/Detail/${f.productId}" class="btn-fav-detail">
                                        <i class="fas fa-eye"></i> İncele
                                    </a>
                                    <button class="btn-remove-fav" onclick="removeFavorite('${f.productId}')">
                                        <i class="fas fa-heart-crack"></i> Kaldır
                                    </button>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                `;

            } catch (e) {
                document.getElementById('favoritesContent').innerHTML = `
                    <div class="empty-favorites">
                        <i class="fas fa-triangle-exclamation"></i>
                        <h2>Favoriler yüklenemedi</h2>
                        <p>Lütfen tekrar deneyin.</p>
                    </div>`;
            }
        }

        async function removeFavorite(productId) {
            try {
                const res = await fetch(`https://localhost:7136/api/favorites/${productId}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (res.ok) {
                    const item = document.getElementById(`fav_${productId}`);
                    item.style.opacity = '0';
                    item.style.transition = 'opacity 0.3s';
                    setTimeout(() => { item.remove(); updateCount(); }, 300);
                    showToast('Favorilerden kaldırıldı.');
                }
            } catch (e) { showToast('Bir hata oluştu.'); }
        }

        function updateCount() {
            const remaining = document.querySelectorAll('.fav-item').length;
            document.getElementById('favCount').textContent = `(${remaining} ürün)`;
            if (remaining === 0) loadFavorites();
        }

        async function addToCart(productId, productName, unitPrice) {
            try {
                const res = await fetch('https://localhost:7124/api/cart/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify({ productId, productName, unitPrice, quantity: 1 })
                });
                if (res.ok) {
                    showToast(`${productName} sepete eklendi!`);
                    updateCartBadge();
                }
            } catch (e) { showToast('Bir hata oluştu.'); }
        }

        async function updateCartBadge() {
            if (!token) return;
            try {
                const res = await fetch('https://localhost:7124/api/cart', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const cart = await res.json();
                const total = cart.items?.reduce((s, i) => s + i.quantity, 0) || 0;
                document.getElementById('cartCount').textContent = total;
            } catch (e) {}
        }

        loadFavorites();
        updateCartBadge();
    </script>
}
