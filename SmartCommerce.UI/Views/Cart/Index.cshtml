@{
    ViewData["Title"] = "Sepetim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .cart-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: 2rem;
        align-items: start;
    }

    .cart-header {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--border);
    }

        .cart-header h1 {
            font-family: var(--font-display);
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text);
        }

            .cart-header h1 span {
                font-size: 0.9rem;
                font-weight: 400;
                color: var(--text-muted);
                margin-left: 0.5rem;
            }

    .btn-clear-cart {
        background: none;
        border: 1px solid var(--border);
        color: var(--text-muted);
        font-family: var(--font-body);
        font-size: 0.8rem;
        padding: 0.4rem 0.85rem;
        border-radius: 6px;
        cursor: pointer;
        transition: border-color 0.2s, color 0.2s;
    }

        .btn-clear-cart:hover {
            border-color: #e74c3c;
            color: #e74c3c;
        }

    .cart-items {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .cart-item {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.25rem;
        display: grid;
        grid-template-columns: 80px 1fr auto;
        gap: 1.25rem;
        align-items: center;
        transition: box-shadow 0.2s;
    }

        .cart-item:hover {
            box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        }

    .cart-item-img {
        width: 80px;
        height: 80px;
        background: var(--surface2);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        color: var(--border);
        flex-shrink: 0;
    }

    .cart-item-info h3 {
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 0.3rem;
    }

    .cart-item-info p {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-bottom: 0.75rem;
    }

    .cart-item-price {
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 700;
        color: var(--accent);
    }

    .cart-item-actions {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.75rem;
    }

    .qty-control {
        display: flex;
        align-items: center;
        border: 1px solid var(--border);
        border-radius: 8px;
        overflow: hidden;
    }

    .qty-btn {
        width: 32px;
        height: 32px;
        background: var(--surface2);
        border: none;
        color: var(--text);
        font-size: 0.9rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.2s;
    }

        .qty-btn:hover {
            background: var(--border);
        }

    .qty-display {
        width: 36px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--text);
        background: var(--surface);
        border-left: 1px solid var(--border);
        border-right: 1px solid var(--border);
    }

    .btn-remove {
        background: none;
        border: none;
        color: var(--text-muted);
        font-size: 0.8rem;
        cursor: pointer;
        transition: color 0.2s;
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }

        .btn-remove:hover {
            color: #e74c3c;
        }

    .empty-cart {
        grid-column: 1 / -1;
        text-align: center;
        padding: 5rem 2rem;
    }

        .empty-cart i {
            font-size: 4rem;
            color: var(--border);
            margin-bottom: 1.5rem;
            display: block;
        }

        .empty-cart h2 {
            font-family: var(--font-display);
            font-size: 1.3rem;
            color: var(--text-dim);
            margin-bottom: 0.5rem;
        }

        .empty-cart p {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 1.5rem;
        }

    .btn-shop {
        background: var(--accent);
        color: #fff;
        text-decoration: none;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        transition: opacity 0.2s;
    }

        .btn-shop:hover {
            opacity: 0.88;
        }

    .order-summary {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.5rem;
        position: sticky;
        top: calc(var(--nav-height) + 32px + 1rem);
    }

        .order-summary h2 {
            font-family: var(--font-display);
            font-size: 1rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 1.25rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--border);
        }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
        font-size: 0.85rem;
    }

        .summary-row .label {
            color: var(--text-dim);
        }

        .summary-row .value {
            color: var(--text);
            font-weight: 500;
        }

        .summary-row.free .value {
            color: var(--accent);
        }

        .summary-row.discount .value {
            color: #e74c3c;
        }

    .summary-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
        margin-top: 0.5rem;
        margin-bottom: 1.25rem;
    }

        .summary-total .label {
            font-family: var(--font-display);
            font-size: 0.9rem;
            font-weight: 700;
            color: var(--text);
        }

        .summary-total .value {
            font-family: var(--font-display);
            font-size: 1.2rem;
            font-weight: 800;
            color: var(--accent);
        }

    /* ── COUPON ── */
    .coupon-section {
        margin-bottom: 1rem;
    }

        .coupon-section label {
            display: block;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--text-dim);
            margin-bottom: 0.4rem;
        }

    .coupon-row {
        display: flex;
        gap: 0.5rem;
    }

        .coupon-row input {
            flex: 1;
            background: var(--surface2);
            border: 1px solid var(--border);
            color: var(--text);
            font-family: var(--font-body);
            font-size: 0.85rem;
            padding: 0.65rem 0.85rem;
            border-radius: 8px;
            outline: none;
            transition: border-color 0.2s;
            text-transform: uppercase;
        }

            .coupon-row input:focus {
                border-color: var(--accent);
            }

            .coupon-row input::placeholder {
                color: var(--text-muted);
                text-transform: none;
            }

            .coupon-row input:disabled {
                opacity: 0.6;
                cursor: not-allowed;
            }

    .btn-coupon {
        background: var(--surface2);
        border: 1px solid var(--border);
        color: var(--text);
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.78rem;
        padding: 0.65rem 1rem;
        border-radius: 8px;
        cursor: pointer;
        white-space: nowrap;
        transition: background 0.2s, border-color 0.2s;
    }

        .btn-coupon:hover {
            background: var(--border);
        }

    .coupon-message {
        margin-top: 0.5rem;
        font-size: 0.78rem;
        min-height: 1.2em;
    }

        .coupon-message.success {
            color: var(--accent);
        }

        .coupon-message.error {
            color: #e74c3c;
        }

    /* ── ADDRESS ── */
    .address-input {
        margin-bottom: 1rem;
    }

        .address-input label {
            display: block;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--text-dim);
            margin-bottom: 0.4rem;
        }

        .address-input textarea {
            width: 100%;
            background: var(--surface2);
            border: 1px solid var(--border);
            color: var(--text);
            font-family: var(--font-body);
            font-size: 0.85rem;
            font-weight: 300;
            padding: 0.65rem 0.85rem;
            border-radius: 8px;
            outline: none;
            resize: none;
            transition: border-color 0.2s;
        }

            .address-input textarea:focus {
                border-color: var(--accent);
            }

            .address-input textarea::placeholder {
                color: var(--text-muted);
            }

    .btn-order {
        width: 100%;
        background: var(--accent);
        color: #fff;
        border: none;
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.9rem;
        letter-spacing: 0.03em;
        padding: 0.9rem;
        border-radius: 8px;
        cursor: pointer;
        transition: opacity 0.2s, transform 0.1s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

        .btn-order:hover {
            opacity: 0.88;
            transform: translateY(-1px);
        }

        .btn-order:active {
            transform: translateY(0);
        }

    .summary-note {
        font-size: 0.72rem;
        color: var(--text-muted);
        text-align: center;
        margin-top: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.3rem;
    }

        .summary-note i {
            color: var(--accent);
        }

    .cart-expire {
        background: rgba(26,107,60,0.08);
        border: 1px solid rgba(26,107,60,0.2);
        border-radius: 8px;
        padding: 0.65rem 1rem;
        font-size: 0.78rem;
        color: var(--accent);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }
</style>

<div class="cart-page" id="cartPage">
    <div class="cart-header">
        <h1>Sepetim <span id="itemCount"></span></h1>
        <button class="btn-clear-cart" onclick="clearCart()">
            <i class="fas fa-trash-can"></i> Sepeti Temizle
        </button>
    </div>

    <div id="cartContent" class="cart-items"></div>

    <aside class="order-summary" id="orderSummary" style="display:none;">
        <h2>Sipariş Özeti</h2>

        <div class="summary-row">
            <span class="label">Ara Toplam</span>
            <span class="value" id="subtotal">0₺</span>
        </div>
        <div class="summary-row discount" id="discountRow" style="display:none;">
            <span class="label">İndirim</span>
            <span class="value" id="discount">-0₺</span>
        </div>
        <div class="summary-row free">
            <span class="label">Kargo</span>
            <span class="value" id="shipping">Ücretsiz</span>
        </div>

        <div class="summary-total">
            <span class="label">Toplam</span>
            <span class="value" id="total">0₺</span>
        </div>

        <!-- KUPON -->
        <div class="coupon-section">
            <label>Kupon Kodu</label>
            <div class="coupon-row">
                <input type="text" id="couponCode" placeholder="Kupon kodunu girin..." />
                <button class="btn-coupon" onclick="applyCoupon()">Uygula</button>
            </div>
            <div class="coupon-message" id="couponMessage"></div>
        </div>

        <!-- ADRES -->
        <div class="address-input">
            <label>Teslimat Adresi</label>
            <textarea id="address" placeholder="Adresinizi girin..." rows="3"></textarea>
        </div>

        <button class="btn-order" onclick="createOrder()">
            <i class="fas fa-lock"></i> Siparişi Tamamla
        </button>

        <p class="summary-note">
            <i class="fas fa-shield-halved"></i>
            256-bit SSL ile güvenli ödeme
        </p>
    </aside>
</div>

@section Scripts {
    <script>
        const token = '@Context.Session.GetString("Token")';
        let appliedCoupon = null;

        async function loadCart() {
            if (!token) {
                document.getElementById('cartContent').innerHTML = `
                    <div class="empty-cart">
                        <i class="fas fa-bag-shopping"></i>
                        <h2>Giriş yapmanız gerekiyor</h2>
                        <p>Sepetinizi görüntülemek için giriş yapın.</p>
                        <a href="/Auth/Login" class="btn-shop">Giriş Yap</a>
                    </div>`;
                return;
            }

            try {
                const res = await fetch('https://localhost:7124/api/cart', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const cart = await res.json();

                if (!cart.items || cart.items.length === 0) {
                    document.getElementById('cartContent').innerHTML = `
                        <div class="empty-cart">
                            <i class="fas fa-bag-shopping"></i>
                            <h2>Sepetiniz boş</h2>
                            <p>Ürünleri keşfetmeye başlayın.</p>
                            <a href="/Product" class="btn-shop">Alışverişe Başla</a>
                        </div>`;
                    document.getElementById('itemCount').textContent = '';
                    document.getElementById('orderSummary').style.display = 'none';
                    document.getElementById('cartCount').textContent = '0';
                    return;
                }

                const totalItems = cart.items.reduce((s, i) => s + i.quantity, 0);
                document.getElementById('itemCount').textContent = `(${totalItems} ürün)`;
                document.getElementById('cartCount').textContent = totalItems;
                document.getElementById('orderSummary').style.display = 'block';

                renderCart(cart);
                updateSummary(cart);

            } catch (e) {
                document.getElementById('cartContent').innerHTML = `
                    <div class="empty-cart">
                        <i class="fas fa-triangle-exclamation"></i>
                        <h2>Sepet yüklenemedi</h2>
                        <p>Lütfen tekrar deneyin.</p>
                    </div>`;
            }
        }

        function renderCart(cart) {
            document.getElementById('cartContent').innerHTML = `
                ${cart.expiresAt ? `<div class="cart-expire"><i class="fas fa-clock"></i> Sepetiniz 30 dakika boyunca saklanır.</div>` : ''}
                ${cart.items.map(item => `
                    <div class="cart-item" id="item_${item.productId}">
                        <div class="cart-item-img">
                            <i class="fas fa-box"></i>
                        </div>
                            <div class="cart-item-info">
                                <h3>${item.productName}</h3>
                                ${item.variantInfo ? `<p style="color:var(--accent);font-size:0.78rem;margin-bottom:0.3rem"><i class="fas fa-tag" style="font-size:0.7rem"></i> ${item.variantInfo}</p>` : ''}
                                <p>Birim Fiyat: ${item.unitPrice.toLocaleString('tr-TR')}₺</p>
                                <div class="cart-item-price">${(item.unitPrice * item.quantity).toLocaleString('tr-TR')}₺</div>
                            </div>
                        <div class="cart-item-actions">
                            <div class="qty-control">
                                <button class="qty-btn" onclick="changeQty('${item.productId}', ${item.unitPrice}, -1)">−</button>
                                <div class="qty-display">${item.quantity}</div>
                                <button class="qty-btn" onclick="changeQty('${item.productId}', ${item.unitPrice}, 1)">+</button>
                            </div>
                            <button class="btn-remove" onclick="removeItem('${item.productId}')">
                                <i class="fas fa-trash-can"></i> Kaldır
                            </button>
                        </div>
                    </div>
                `).join('')}
            `;
        }

        function updateSummary(cart) {
            const total = cart.totalAmount || cart.items.reduce((s, i) => s + i.unitPrice * i.quantity, 0);
            document.getElementById('subtotal').textContent = total.toLocaleString('tr-TR') + '₺';
            document.getElementById('shipping').textContent = total >= 500 ? 'Ücretsiz' : '49₺';
            document.getElementById('total').textContent = (total >= 500 ? total : total + 49).toLocaleString('tr-TR') + '₺';
        }

        function recalcSummary() {
            let total = 0;
            document.querySelectorAll('.cart-item').forEach(el => {
                const price = parseFloat(
                    el.querySelector('.cart-item-price').textContent
                    .replace(/\./g, '')
                    .replace(',', '.')
                    .replace('₺', '')
                    .trim()
                );
                total += isNaN(price) ? 0 : price;
            });

            document.getElementById('subtotal').textContent = total.toLocaleString('tr-TR') + '₺';

            // Kupon varsa yeniden uygula
            if (appliedCoupon) {
                let discounted = appliedCoupon.discountType === 1
                    ? total * appliedCoupon.discountValue / 100
                    : appliedCoupon.discountValue;
                if (discounted > total) discounted = total;
                const finalTotal = total - discounted;
                document.getElementById('discount').textContent = '-' + discounted.toLocaleString('tr-TR') + '₺';
                document.getElementById('discountRow').style.display = 'flex';
                document.getElementById('shipping').textContent = finalTotal >= 500 ? 'Ücretsiz' : '49₺';
                document.getElementById('total').textContent = (finalTotal >= 500 ? finalTotal : finalTotal + 49).toLocaleString('tr-TR') + '₺';
            } else {
                document.getElementById('shipping').textContent = total >= 500 ? 'Ücretsiz' : '49₺';
                document.getElementById('total').textContent = (total >= 500 ? total : total + 49).toLocaleString('tr-TR') + '₺';
            }
        }

        async function applyCoupon() {
            const code = document.getElementById('couponCode').value.trim();
            if (!code) { showToast('Lütfen kupon kodu girin!'); return; }

            const subtotalText = document.getElementById('subtotal').textContent
                .replace(/\./g, '').replace(',', '.').replace('₺', '').trim();
            const cartTotal = parseFloat(subtotalText);

            try {
                const res = await fetch('https://localhost:7124/api/coupons/apply', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify({ code, cartTotal })
                });

                if (res.ok) {
                    appliedCoupon = await res.json();

                    const msgEl = document.getElementById('couponMessage');
                    msgEl.className = 'coupon-message success';
                    msgEl.innerHTML = `<i class="fas fa-check"></i> ${appliedCoupon.discountType === 1 ? '%' + appliedCoupon.discountValue : appliedCoupon.discountValue.toLocaleString('tr-TR') + '₺'} indirim uygulandı!`;

                    document.getElementById('discountRow').style.display = 'flex';
                    document.getElementById('discount').textContent = '-' + appliedCoupon.discountedAmount.toLocaleString('tr-TR') + '₺';

                    const shipping = appliedCoupon.finalAmount >= 500 ? 0 : 49;
                    document.getElementById('shipping').textContent = shipping === 0 ? 'Ücretsiz' : '49₺';
                    document.getElementById('total').textContent = (appliedCoupon.finalAmount + shipping).toLocaleString('tr-TR') + '₺';

                    document.getElementById('couponCode').disabled = true;
                } else {
                    const err = await res.text();
                    const msgEl = document.getElementById('couponMessage');
                    msgEl.className = 'coupon-message error';
                    msgEl.innerHTML = `<i class="fas fa-xmark"></i> ${err}`;
                    appliedCoupon = null;
                }
            } catch (e) { showToast('Bir hata oluştu.'); }
        }

        async function removeItem(productId) {
            try {
                const res = await fetch(`https://localhost:7124/api/cart/${productId}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                if (res.ok) {
                    showToast('Ürün sepetten kaldırıldı.');
                    loadCart();
                }
            } catch (e) {}
        }

        async function changeQty(productId, unitPrice, delta) {
            try {
                const itemEl = document.getElementById(`item_${productId}`);
                const currentQty = parseInt(itemEl.querySelector('.qty-display').textContent);
                const newQty = currentQty + delta;

                if (newQty <= 0) { await removeItem(productId); return; }

                const res = await fetch('https://localhost:7124/api/cart', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const cart = await res.json();
                const item = cart.items.find(i => i.productId === productId);
                if (!item) return;

                await fetch(`https://localhost:7124/api/cart/${productId}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': 'Bearer ' + token }
                });

                await fetch('https://localhost:7124/api/cart/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ productId, productName: item.productName, unitPrice: item.unitPrice, quantity: newQty })
                });

                itemEl.querySelector('.qty-display').textContent = newQty;
                itemEl.querySelector('.cart-item-price').textContent = (item.unitPrice * newQty).toLocaleString('tr-TR') + '₺';

                recalcSummary();

                const allQty = [...document.querySelectorAll('.qty-display')]
                    .reduce((s, el) => s + parseInt(el.textContent), 0);
                document.getElementById('itemCount').textContent = `(${allQty} ürün)`;
                document.getElementById('cartCount').textContent = allQty;

            } catch (e) { showToast('Bir hata oluştu.'); }
        }

        async function clearCart() {
            try {
                const res = await fetch('https://localhost:7124/api/cart', {
                    headers: { 'Authorization': 'Bearer ' + token }
                });
                const cart = await res.json();
                for (const item of cart.items) {
                    await fetch(`https://localhost:7124/api/cart/${item.productId}`, {
                        method: 'DELETE',
                        headers: { 'Authorization': 'Bearer ' + token }
                    });
                }
                showToast('Sepet temizlendi.');
                appliedCoupon = null;
                loadCart();
            } catch (e) { showToast('Bir hata oluştu.'); }
        }

         async function createOrder() {
            const address = document.getElementById('address').value.trim();
            if (!address) { showToast('Lütfen teslimat adresinizi girin.'); return; }

            // Loading butonu
            const btn = document.querySelector('.btn-order');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> İşleniyor...';

            try {
                const res = await fetch('https://localhost:7124/api/order', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + token
                    },
                    body: JSON.stringify({
                        address,
                        couponCode: appliedCoupon?.code || null
                    })
                });

                if (res.ok) {
                    btn.innerHTML = '<i class="fas fa-check"></i> Siparişiniz Alındı!';
                    btn.style.background = '#2ecc71';
                    setTimeout(() => window.location.href = '/Order', 1500);
                } else {
                    const err = await res.text();
                    showToast(err || 'Bir hata oluştu.');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-lock"></i> Siparişi Tamamla';
                }
            } catch (e) {
                showToast('Bağlantı hatası.');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-lock"></i> Siparişi Tamamla';
            }
        }

        loadCart();
    </script>
}
